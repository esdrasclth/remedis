# Base de datos (coincide con el servicio postgres de docker-compose.yml)
DATABASE_URL=postgresql://remedis:remedis_dev@localhost:5432/remedis

# Auth.js — genera AUTH_SECRET con: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dominio raíz de los subdominios por empresa (miempresa.<dominio>)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Archivos (MinIO / S3)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=remedis

# Correo (Resend)
RESEND_API_KEY=
EMAIL_FROM=Remedis <onboarding@resend.dev>

# Suscripciones (Stripe, modo prueba en desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Protege las rutas de tareas programadas
CRON_SECRET=
